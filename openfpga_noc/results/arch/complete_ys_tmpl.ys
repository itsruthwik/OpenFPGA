# Yosys synthesis script for ${TOP_MODULE}
plugin -i  /mnt/vault1/rsunketa/vtr-verilog-to-routing/build/parmys/parmys.so
read_verilog -nomem2reg /mnt/vault1/rsunketa/OpenFPGA/vtr-verilog-to-routing/build/share/yosys/parmys/vtr_primitives.v
setattr -mod -set keep_hierarchy 1 single_port_ram
setattr -mod -set keep_hierarchy 1 dual_port_ram

# parmys_arch -a /mnt/vault1/rsunketa/OpenFPGA/openfpga_noc/results/soft_noc_hbm_eth_results/pe_2_switch_hbm_eth/baseline_complexDSP_mem32k_hbm_eth_vpr.xml
parmys_arch -a /mnt/vault1/rsunketa/OpenFPGA/openfpga_noc/results/arch/mesh_4x4_complexDSP_mem32k_hbm_eth_vpr.xml

#########################
# Parse input files
#########################
# Read verilog files
# read_verilog -sv -nolatches ${VERILOG_FILES}
read_verilog -sv -nolatches /mnt/vault1/rsunketa/OpenFPGA/openfpga_noc/results/benchmarks/hard_noc/pe_2_noc.v

# Read technology library


# read_verilog -lib -sv -specify ${YOSYS_CELL_SIM_VERILOG}
# read_verilog -sv -lib -specify /mnt/vault1/mfaroo19/OpenFPGA/openfpga-test-runs/001-shashank-router-tasks/router-rtl/router_wrap_cell_sim.sv
#read_verilog -sv -lib -specify ${ROUTER_BLACKBOX_VERILOG}

#########################
# Prepare for synthesis
#########################
# Identify top module from hierarchy
hierarchy -check -top pe_15_noc
# - Convert process blocks to AST
proc
# techmap -map +/adff2dff.v
# Flatten all the gates/primitives
flatten
# Identify tri-state buffers from 'z' signal in AST
# with follow-up optimizations to clean up AST
tribuf -logic
opt_expr
opt_clean
# demote inout ports to input or output port
# with follow-up optimizations to clean up AST
deminout
opt -nodffe -nosdff

opt_expr
opt_clean
check
opt -nodffe -nosdff
wreduce -keepdc
peepopt
pmuxtree
opt_clean

techmap -map +/parmys/adff2dff.v

techmap -map +/parmys/adffe2dff.v

techmap -map +/parmys/aldff2dff.v

techmap -map +/parmys/aldffe2dff.v

opt -full










# # parmys -a /mnt/vault1/rsunketa/OpenFPGA/openfpga_noc/results/soft_noc_hbm_eth_results/pe_2_switch_hbm_eth/baseline_complexDSP_mem32k_hbm_eth_vpr.xml -c /mnt/vault1/rsunketa/OpenFPGA/openfpga_noc/results/soft_noc_hbm_eth_results/pe_2_switch_hbm_eth/odin_config.xml YYY
parmys -a /mnt/vault1/rsunketa/OpenFPGA/openfpga_noc/results/hard_noc_results/pe_2_noc/mesh_4x4_complexDSP_mem32k_hbm_eth_vpr.xml -c /mnt/vault1/rsunketa/OpenFPGA/openfpga_noc/results/hard_noc_results/pe_2_noc/odin_config.xml YYY



